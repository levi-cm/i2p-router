# Optional settings for docker-compose.yml. Copy to .env only if you change
# something; every value below is already the default.
#
# The console password does NOT go here. It lives in secrets/i2pd_http_pass
# (see README.md, Quick start).

# --- Exposure -----------------------------------------------------------------
# Each service is published on 127.0.0.1 only. To reach one from another
# machine, set its address to ONE specific trusted interface address, never
# 0.0.0.0 (the entrypoint refuses wildcard binds). Docker-published ports
# bypass host firewalls such as ufw. Read "LAN and Tailscale access" in
# README.md first.
#
# HTTP proxy (port 4444). No authentication: anyone who can reach it uses I2P
# as you.
#I2PD_PROXY_BIND_IP=127.0.0.1
#
# Web console (port 7070). HTTP Basic auth over plain HTTP.
#I2PD_CONSOLE_BIND_IP=127.0.0.1
#
# SAM bridge (port 7656). No authentication and roughly shell-level access:
# SAM clients can make the container open connections to anything it can
# reach. Keep it on 127.0.0.1.
#I2PD_SAM_BIND_IP=127.0.0.1

# --- Web console -------------------------------------------------------------------
#I2PD_HTTP_USER=i2pd
# The console answers 403 unless the browser's Host header matches this name
# or address. Defaults to I2PD_CONSOLE_BIND_IP, so open http://127.0.0.1:7070
# (not http://localhost:7070) unless you change it.
#I2PD_CONSOLE_HOSTNAME=127.0.0.1
# Host path of the password file, if not secrets/i2pd_http_pass.
#I2PD_HTTP_PASS_FILE=./secrets/i2pd_http_pass

# --- Router ------------------------------------------------------------------------
# Bandwidth is fixed at class O (256 KB/s). Percent of it offered to other
# routers' transit traffic; 0 disables transit entirely. This is a target, not
# a cap: i2pd refuses new transit tunnels above it and never throttles your own
# traffic.
#I2PD_SHARE=50
# Router identity and state. Must be owned by I2PD_USER (README, Quick start).
#I2PD_DATA_DIR=./i2pd

# --- Container ------------------------------------------------------------------
# uid:gid inside the container. Never 0 (the entrypoint refuses root).
#I2PD_USER=100:65533
#I2PD_MEM_LIMIT=512m
#I2PD_PIDS_LIMIT=256
#I2PD_CPUS=1.0

# Image override. Leave unset to follow the reviewed pin in docker-compose.yml;
# a value here keeps you on that image when the repository pin moves. If you
# set it, use a release tag pinned by digest:
#I2PD_IMAGE=purplei2p/i2pd:release-<version>@sha256:<index-digest>
